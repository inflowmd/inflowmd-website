# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated PDF reports
/output/

# Captured leads — real contact details, never committed
/data/leads.json

# Verification screenshots — scratch, never shipped
/booth-*.png
/glow-*.png
/cr-*.png
/logo-*.png
/audit-*.png
/pitch-*.png

# Prospect research — verification notes, never shipped
research/

# Conference attendee CSV — superseded by data/hps-practices.json and kept
# locally only. NOTE: an older 3-row version of this path is already in git
# history and is still tracked on some branches; ignoring it here stops it
# being re-added, it does not remove what is already committed.
data/attendees.csv

# Stale duplicate of the booth client. The live one is
# src/app/audit/BoothClient.tsx; this copy is imported by nothing and no
# longer type-checks against the current AuditScores type.
src/app/booth/BoothClient.tsx

# Claude Code's own worktree state — never belongs to the project.
.claude/worktrees/
